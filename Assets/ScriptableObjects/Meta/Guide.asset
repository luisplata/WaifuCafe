  m_Name: Guide
  m_EditorClassIdentifier: Assembly-CSharp::V2.Meta.GuideSO
  managerName: MANAGER
  portrait: {fileID: 6484472854786379645, guid: f48eb54ba38c56749b87d8313b57bba8, type: 3}
  pages:
  - title: "CONTRATOS"
    body: "Cada día ves una selección de 3 contratos del catálogo; al lanzar la run la selección rota. El recomendado es sólo una sugerencia: podés elegir otro. Hora del Té y Desayuno Real todavía no están disponibles."
    focus: 0
  - title: "PARTY Y SINERGIA"
    body: "Arm\xE1 una party de 4 waifus distintas. Las facciones y roles repetidos activan sinergias; con 3 M\xEDticos y una de 3 estrellas se desbloquea la ultimate Luna de Sangre."
    focus: 1
  - title: "GACHA - PR\xD3XIMAMENTE"
    body: "El gacha llega m\xE1s adelante: por ahora el roster se gana jugando, y las estrellas subir\xE1n con dupes cuando est\xE9 disponible."
    focus: 2
  - title: "RESTAURANTE - PR\xD3XIMAMENTE"
    body: "El restaurante tambi\xE9n llega m\xE1s adelante. Es la parte de gesti\xF3n del caf\xE9; con los contratos y la party ya ten\xE9s todo para el primer d\xEDa."
    focus: 3
